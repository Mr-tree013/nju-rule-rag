APP_TITLE=NJU Rule RAG

# LLM API — 本地 Qwen3-8B（无思考模式）
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b-nothink

# LLM 回退 — 本地模型故障时切到 DeepSeek
ENABLE_LLM_FALLBACK=true
FALLBACK_LLM_API_KEY=sk-2b1b96e89fea4cdeb90f6aaf614d6572
FALLBACK_LLM_BASE_URL=https://api.deepseek.com
FALLBACK_LLM_MODEL=deepseek-chat

# Embedding API (uses DeepSeek for API-mode embeddings)
EMBEDDING_API_KEY=sk-2b1b96e89fea4cdeb90f6aaf614d6572
EMBEDDING_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=text-embedding-ada-002
# Data paths
DATA_DIR=data
CHUNKS_FILE=data/chunks/chunks.jsonl
INDEX_DIR=data/index

# Retrieval
BM25_TOP_K=10
VECTOR_TOP_K=10



HYBRID_TOP_K=5
MIN_RELIABLE_SCORE=0.2
HIGH_RISK_MIN_SCORE=0.25

# QQ Bot (NapCat OneBot v11)
QQ_BOT_SELF_ID=3999866146
QQ_BOT_API_BASE_URL=http://127.0.0.1:8000

# Query rewriting (normalise colloquial questions)
ENABLE_TWO_STAGE_GENERATION=false
ENABLE_QUERY_REWRITE=true

# Reranker (two-stage retrieval)
ENABLE_RERANK=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=40
RERANK_TOP_K=12

# Build options
ENABLE_VECTOR=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# ── v0.5.1: Prompt budget ──────────────────────────────────────
PROMPT_TOKEN_BUDGET=4096
MAX_CHUNK_TOKENS=320
MAX_CHUNKS_IN_PROMPT=6

# ── v0.5.1: LLM timeout & circuit breaker ──────────────────────
LLM_REQUEST_TIMEOUT=60
LLM_TTFT_TIMEOUT_SECONDS=5

# ── v0.5.1: GPU memory management ──────────────────────────────
EMPTY_CACHE_EVERY_N_REQUESTS=20
EMPTY_CACHE_FREE_VRAM_MB=1500
RERANKER_DEVICE=auto
